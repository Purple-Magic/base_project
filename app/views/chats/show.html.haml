= tramway_container class: 'h-full min-h-0 max-h-[1200px]' do
  .flex.h-full.min-h-0.flex-col.gap-8.py-10
    = tramway_title text: @chat.title

    %p.text-sm.text-slate-600
      = pluralize(@chat.members_count, 'member')
      in this chat

    .grid.flex-1.min-h-0.gap-8{ class: 'lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]' }
      .flex.min-h-0.flex-col.gap-4
        .rounded-3xl.border.border-slate-200.bg-white.p-5.shadow-sm
          %p.text-xs.font-semibold.uppercase.tracking-widest.text-slate-500 Chat UUID
          %p.mt-2.break-all.font-mono.text-sm.text-slate-800= @chat.uuid
          %p.mt-4.text-sm.text-slate-600
            Created
            = l(@chat.created_at, format: :long)

        .flex-1.min-h-0.overflow-hidden{ data: { controller: 'chat', 'chat-chat-id-value': @chat.uuid, 'chat-messages-path-value': chats_messages_path, 'chat-next-page-value': 2 } }
          = tramway_chat chat_id: @chat.uuid,
            messages: @chat.transcript_messages(page: 1),
            message_form: @message_form,
            send_message_path: chats_messages_path

      .space-y-4
        %h2.text-lg.font-semibold.text-slate-900 Members

        = tramway_table do
          = tramway_header headers: ['Member', 'Chats']

          - @members.each do |member|
            = tramway_row do
              = tramway_cell do
                = member.full_name
              = tramway_cell do
                = member.chats_count
