!!!
%html
  %head
    %title= content_for(:title) || "Tramway Project"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}
    %meta{name: "apple-mobile-web-app-capable", content: "yes"}
    %meta{name: "application-name", content: "Tramway Project"}
    %meta{name: "mobile-web-app-capable", content: "yes"}
    = csrf_meta_tags
    = csp_meta_tag

    = yield :head

    -# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!)
    -#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json)

    %link{rel: "icon", href: "/icon.png", type: "image/png"}
    %link{rel: "icon", href: "/icon.svg", type: "image/svg+xml"}
    %link{rel: "apple-touch-icon", href: "/icon.png"}

    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = javascript_importmap_tags
    = stylesheet_link_tag "trix", "data-turbo-track": "reload"
    = javascript_include_tag "trix", "data-turbo-track": "reload", defer: true

  %body.min-h-dvh.flex.flex-col
    = tramway_navbar title: 'Chats', title_link: root_path, with_entities: false do |nav|
      - nav.left do
        - nav.item 'Browse chats', root_path
        - nav.item 'Posts', posts_path

      - nav.right do
        - if logged_in_using_omniauth?
          - if current_user_name.present?
            - nav.item current_user_name, user_path
          - nav.item 'Profile', user_path
          - nav.item 'Logout', auth0_logout_path, method: :get, data: { turbo: false }
        - else
          - nav.item 'Login', '/auth/auth0', method: :post, data: { turbo: false }
          - if Rails.env.development?
            - nav.item 'Dev Login', dev_login_path, method: :post, data: { turbo: false }

    = tramway_main_container do
      - if flash.any?
        = tramway_flash text: flash[:notice].presence || flash[:alert],
          type: flash[:notice].present? ? :will : :rage,
          id: 'flash-container'

      = yield
