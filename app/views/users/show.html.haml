= tramway_container do
  .space-y-8.py-10
    = tramway_title text: 'Your profile'

    .grid.gap-6{ class: 'lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)]' }
      .rounded-3xl.border.border-slate-200.bg-white.p-6.shadow-sm
        %p.text-xs.font-semibold.uppercase.tracking-widest.text-slate-500 Account
        %dl.mt-4.space-y-4.text-sm.text-slate-700
          %div
            %dt.font-semibold.text-slate-900 Name
            %dd.mt-1= current_user_name || 'Not provided'
          - if @user[:nickname].present?
            %div
              %dt.font-semibold.text-slate-900 Nickname
              %dd.mt-1= @user[:nickname]
          - if @user[:email].present?
            %div
              %dt.font-semibold.text-slate-900 Email
              %dd.mt-1= @user[:email]
          - if @user[:sub].present?
            %div
              %dt.font-semibold.text-slate-900 Auth0 subject
              %dd.mt-1.break-all.font-mono.text-xs= @user[:sub]

      .rounded-3xl.border.border-slate-200.bg-slate-950.p-6.text-sm.text-slate-100.shadow-sm
        %p.text-xs.font-semibold.uppercase.tracking-widest.text-slate-400 Raw profile payload
        %pre.mt-4.whitespace-pre-wrap.break-words.font-mono.text-xs.leading-6= JSON.pretty_generate(@user)
